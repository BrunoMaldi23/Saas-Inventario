generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

model User {
  id             String             @id @default(uuid()) @db.Uuid
  email          String             @unique
  name           String
  passwordHash   String
  status         AccountStatus      @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  memberships    TenantMembership[]
  sessions       Session[]
  auditEvents    AuditLog[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
}

model Tenant {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  status            AccountStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       TenantMembership[]
  roles             Role[]
  sessions          Session[]
  auditEvents       AuditLog[]
  companies         Company[]
  branches          Branch[]
  categories        Category[]
  products          Product[]
  suppliers         Supplier[]
  warehouses        Warehouse[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  stockTransfers    StockTransfer[]
}

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  name         String
  taxId        String?
  businessType String?
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches     Branch[]

  @@unique([id, tenantId])
  @@unique([tenantId, taxId])
  @@index([tenantId, status, name])
}

model Branch {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  companyId  String        @db.Uuid
  name       String
  address    String?
  status     AccountStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company       @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  warehouses Warehouse[]

  @@unique([id, tenantId])
  @@index([tenantId, status, name])
  @@index([companyId, tenantId])
}

model Category {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  name      String
  parentId  String?       @db.Uuid
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent    Category?     @relation("CategoryTree", fields: [parentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  children  Category[]    @relation("CategoryTree")
  products  Product[]

  @@unique([id, tenantId])
  @@index([tenantId, status, name])
  @@index([parentId, tenantId])
}

model Product {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  categoryId    String?            @db.Uuid
  sku           String?
  barcode       String?
  name          String
  description   String?
  unitOfMeasure String
  status        AccountStatus      @default(ACTIVE)
  minStock      Decimal?           @db.Decimal(18, 3)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category      Category?          @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  balances      InventoryBalance[]
  movements     StockMovement[]
  transfers     StockTransfer[]

  @@unique([id, tenantId])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, status, name])
  @@index([categoryId, tenantId])
}

model Supplier {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  name      String
  taxId     String?
  email     String?
  phone     String?
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, name])
}

model Warehouse {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  branchId     String             @db.Uuid
  name         String
  type         String
  status       AccountStatus      @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch             @relation(fields: [branchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  balances     InventoryBalance[]
  movements    StockMovement[]
  transfersOut StockTransfer[]    @relation("TransferOrigin")
  transfersIn  StockTransfer[]    @relation("TransferDestination")

  @@unique([id, tenantId])
  @@unique([tenantId, branchId, name])
  @@index([tenantId, status, name])
  @@index([branchId, tenantId])
}

enum MovementType {
  INITIAL
  ENTRY
  ISSUE
  ADJUSTMENT
  TRANSFER
}

enum MovementDirection {
  IN
  OUT
}

enum TransferStatus {
  COMPLETED
}

model InventoryBalance {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  warehouseId String    @db.Uuid
  productId   String    @db.Uuid
  quantity    Decimal   @db.Decimal(18, 3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  product     Product   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  warehouseId     String            @db.Uuid
  productId       String            @db.Uuid
  transferId      String?           @db.Uuid
  type            MovementType
  direction       MovementDirection
  quantity        Decimal           @db.Decimal(18, 3)
  reason          String?
  createdByUserId String            @db.Uuid
  createdAt       DateTime          @default(now())
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse       Warehouse         @relation(fields: [warehouseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  product         Product           @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  transfer        StockTransfer?    @relation(fields: [transferId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy       User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt, id])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, createdByUserId, createdAt])
  @@index([transferId, tenantId])
}

model StockTransfer {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  fromWarehouseId String          @db.Uuid
  toWarehouseId   String          @db.Uuid
  productId       String          @db.Uuid
  quantity        Decimal         @db.Decimal(18, 3)
  status          TransferStatus  @default(COMPLETED)
  reason          String?
  createdByUserId String          @db.Uuid
  createdAt       DateTime        @default(now())
  completedAt     DateTime        @default(now())
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromWarehouse   Warehouse       @relation("TransferOrigin", fields: [fromWarehouseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  toWarehouse     Warehouse       @relation("TransferDestination", fields: [toWarehouseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  product         Product         @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy       User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  movements       StockMovement[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, fromWarehouseId, createdAt])
  @@index([tenantId, toWarehouseId, createdAt])
}

model Role {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  name        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships TenantMembership[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model TenantMembership {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  userId    String        @db.Uuid
  roleId    String        @db.Uuid
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role          @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique
  activeTenantId String?  @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant   Tenant?  @relation(fields: [activeTenantId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  entityId    String   @db.Uuid
  details     Json?
  createdAt   DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}
