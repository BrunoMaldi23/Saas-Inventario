# Copy to .env and replace the local-only password before starting PostgreSQL.
POSTGRES_DB=inventariosaas
POSTGRES_USER=inventariosaas
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=55432
DATABASE_URL=postgresql://inventariosaas:change-me-local@127.0.0.1:55432/inventariosaas?schema=public
API_PORT=3000
WEB_PORT=5173
NODE_ENV=development

# One-time bootstrap inputs. Set only in local .env when running pnpm db:bootstrap.
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_TENANT_NAME=
