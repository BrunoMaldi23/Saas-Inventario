{
  "name": "inventariosaas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,yaml,yml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,yaml,yml,css,html}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  }
}
